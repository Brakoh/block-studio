---
import StudioLayout from '../layouts/StudioLayout.astro';
import '../styles/home.css';
import { copy } from '../lib/copy';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects_edit')).sort((a, b) =>
	a.id.localeCompare(b.id),
);

function projectIndex(id: string) {
	const match = id.match(/^(\d+)/);
	return match ? match[1] : id;
}

const logo = `${copy.identity.word}.`;
const { home } = copy;
---

<StudioLayout page="home">
	<nav>
		<div class="logo">{logo}</div>
		<ul class="nav-links">
			<li><a href="#about">{home.nav.about}</a></li>
			<li><a href="#work">{home.nav.work}</a></li>
			<li><a href="#contact">{home.nav.contact}</a></li>
		</ul>
		<div class="nav-coord" id="nav-time"></div>
	</nav>

	<section class="hero">
		<div class="hero-grid">
			<h1 class="reveal">{copy.identity.word}<span class="square-dot"></span></h1>
			<span class="hero-sub reveal">{home.hero.location}</span>
			<div class="hero-coord reveal">
				{home.hero.coord}
			</div>
		</div>
	</section>

	<div class="coord-divider reveal">
		<span>{home.dividers[0]}</span>
	</div>

	<section id="about">
		<div class="section-header reveal">
			<div class="section-label">{home.about.label}</div>
			<div class="section-number">{home.about.number}</div>
		</div>
		<div class="about-grid">
			<div class="about-text">
				{home.about.paragraphs.map((paragraph, i) => (
					<>
						{i > 0 && <br />}
						<p class="reveal">{paragraph}</p>
					</>
				))}
			</div>
			<div class="about-coords">
				{home.about.facts.map((fact) => (
					<div class="coord-block reveal">
						<span class="coord-label">{fact.label}</span>
						<span class="coord-value">{fact.value}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<div class="coord-divider reveal">
		<span>{home.dividers[1]}</span>
	</div>

	<section id="work">
		<div class="section-header reveal">
			<div class="section-label">{home.work.label}</div>
			<div class="section-number">{home.work.number}</div>
		</div>
		<div class="projects-list">
			{projects.map((project) => (
				<a href={project.data.url} class="project-item reveal">
					<span class="project-index">{projectIndex(project.id)}</span>
					<div class="project-info">
						<h3>{project.data.title}</h3>
						<span class="project-tag">{project.data.tag}</span>
					</div>
					<span class="project-coord">{project.data.inscription}</span>
				</a>
			))}
		</div>
	</section>

	<div class="coord-divider reveal">
		<span>{home.dividers[2]}</span>
	</div>

	<section id="contact">
		<div class="section-header reveal">
			<div class="section-label">{home.contact.label}</div>
			<div class="section-number">{home.contact.number}</div>
		</div>
		<div class="contact-content">
			<h2 class="section-title reveal">{home.contact.title[0]}<br /><span>{home.contact.title[1]}</span></h2>
			<a href={`mailto:${copy.identity.email}`} class="contact-email reveal">{copy.identity.email}</a>
			<div class="contact-coords">
				{home.contact.places.map((place) => (
					<div class="contact-coord-item reveal">
						<div class="label">{place.label}</div>
						<div class="value">{place.value}</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<footer>
		<span class="reveal">{home.footer.copyright}</span>
		<span class="reveal">{home.footer.coord}</span>
	</footer>

	<script>
		import { initStudioUI, startUtcClock, resetHomeScroll, initScrollReveal } from '../scripts/studio-ui.js';
		import { withBase } from '../lib/base';

		resetHomeScroll();
		initStudioUI({ magnet: true });
		startUtcClock(document.getElementById('nav-time'));
		initScrollReveal();

		document.querySelector('.hero h1')?.addEventListener('click', () => {
			location.href = withBase('globe');
		});
		document.addEventListener('click', (e) => {
			if (e.target instanceof Element && e.target.closest('.hero h1')) {
				location.href = withBase('globe');
			}
		});
	</script>
</StudioLayout>
