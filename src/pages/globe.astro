---
import StudioLayout from '../layouts/StudioLayout.astro';
import '../styles/globe.css';
import { copy } from '../lib/copy';
import { withBase } from '../lib/base';
---

<StudioLayout page="globe">
	<button class="globe-return" id="globe-return">{copy.globe.return}</button>
	<a href={withBase('loudness')} class="globe-tag" id="globe-tag-loudness"><span>{copy.globe.tags.loudness}</span></a>
	<a href={withBase('overseers')} class="globe-tag" id="globe-tag-overseers"><span>{copy.globe.tags.overseers}</span></a>
	<a href={withBase('waste')} class="globe-tag" id="globe-tag-waste"><span>{copy.globe.tags.waste}</span></a>

	<script>
		import { initStudioUI } from '../scripts/studio-ui.js';
		import { withBase } from '../lib/base';

		initStudioUI({ magnet: true, parkCursor: true });

		function goHome() {
			location.href = withBase();
		}
		document.getElementById('globe-return')?.addEventListener('click', goHome);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') goHome();
		});
	</script>

	<script is:inline src={withBase('scripts/globe-sphere.js')}></script>
</StudioLayout>
